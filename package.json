{
  "name": "sfmc-apis",
  "version": "0.1.0",
  "private": true,
  "description": "Agent-oriented migration toolkit for Salesforce Marketing Cloud Engagement: OpenAPI contract, migration recipes, catalog builder, and MCP server stub.",
  "scripts": {
    "build": "node scripts/build-swagger-site.mjs",
    "catalog": "node scripts/build-migration-catalog.mjs",
    "postman:soap": "node scripts/build-postman-soap-collection.mjs",
    "validate:openapi": "npx -y @apidevtools/swagger-cli validate specs/sfmc_marketing_cloud_openapi.yaml",
    "lint:openapi": "npx -y @stoplight/spectral-cli lint --fail-severity=error specs/sfmc_marketing_cloud_openapi.yaml",
    "check:scopes": "node scripts/check-scope-sync.mjs",
    "check:migrations": "node scripts/check-migration-extensions.mjs",
    "mcp": "node scripts/mcp-server.mjs",
    "setup": "node scripts/setup-connection.mjs",
    "validate": "npm run validate:openapi && npm run lint:openapi && npm run check:operationIds && npm run check:scopes && npm run check:migrations && npm run catalog && npm run bundle:openapi",
    "check:operationIds": "node scripts/check-operation-ids.mjs",
    "bundle:openapi": "npx -y @apidevtools/swagger-cli bundle -t yaml -o dist/sfmc.yaml specs/sfmc_marketing_cloud_openapi.yaml"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "js-yaml": "^4.1.0"
  }
}
